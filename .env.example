# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real ARNs or credentials.

# Required — the SNS topic that receives the weekly report
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:891612540541:cost-audit-alerts

# Optional — defaults shown below, only set if different
PRICING_REGION=US East (N. Virginia)
VOLUME_TYPE=gp3
